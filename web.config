<?xml version="1.0" encoding="utf-8"?>
<!--
  MC-JACOB GLOBAL FARMS LTD
  IIS web.config for Node.js via iisnode (SmarterASP.NET shared hosting)
-->
<configuration>
  <system.webServer>

    <!-- Tell IIS to handle all requests through iisnode → server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL Rewrite: route all requests to server.js (Express handles routing) -->
    <rewrite>
      <rules>
        <!-- Do NOT intercept iisnode internal debugging traffic -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Send all other requests through Express (server.js) -->
        <rule name="DynamicContent" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode settings -->
    <iisnode
      node_env="production"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />

    <!-- Security: block direct access to sensitive files/folders -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="config" />
          <add segment="middleware" />
          <add segment="routes" />
          <add segment="iisnode" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Default document (not strictly needed since Express handles /) -->
    <defaultDocument enabled="false" />

    <!-- Increase upload limit for receipt/product images (10MB) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
